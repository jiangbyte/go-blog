# MYSQL（本机 Docker 容器 mysql）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=infra123!
MYSQL_DATABASE=go_blog
MYSQL_DOCKER=mysql

# REDIS（本机 Docker 容器 redis）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=infra123!

TOKEN_TTL_SECONDS=604800
TOKEN_COOKIE_NAME=token
TOKEN_COOKIE_NAME_ADMIN=token_admin
TOKEN_HEADER_NAME=X-Token
# true | false | auto（按 TLS / X-Forwarded-Proto）
TOKEN_COOKIE_SECURE=auto

# 逗号分隔；空 Origin（同源）不依赖此项
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
AUTH_RSA_KEY_PATH=data/rsa_private.pem
PUBLIC_SITE_URL=https://example.com
# IndexNow 密钥（与 web/apps/blog/public/{key}.txt 一致）；空则不推送
INDEXNOW_KEY=

APP_NAME=go-blog
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# 对象存储：默认引擎 QINIU（改后需重启）；单次上传可传 storage_provider 覆盖
DEFAULT_FILE_ENGINE=QINIU
STORAGE_UPLOAD_MAX_BYTES=10485760
STORAGE_PRESIGN_EXPIRE_SECONDS=3600
STORAGE_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf,.txt,.md,.zip

# MinIO / Silo（暂不用）
# STORAGE_MINIO_ACCESS_KEY=admin
# STORAGE_MINIO_SECRET_KEY=infra123!
# STORAGE_MINIO_ENDPOINT=127.0.0.1:9000
# STORAGE_MINIO_BUCKET=go-blog
# STORAGE_MINIO_REGION=
# STORAGE_MINIO_USE_SSL=false
# STORAGE_MINIO_BASE_URL=http://127.0.0.1:9000
# STORAGE_MINIO_BUCKET_PUBLIC=false

# 七牛云 Kodo
STORAGE_QINIU_ACCESS_KEY=
STORAGE_QINIU_SECRET_KEY=
STORAGE_QINIU_ENDPOINT=
STORAGE_QINIU_BUCKET=
STORAGE_QINIU_REGION=z2
# 图床固定 HTTP，BASE_URL 带 scheme 时不会被改成 https
STORAGE_QINIU_USE_SSL=false
STORAGE_QINIU_BASE_URL=http://images.example.com
STORAGE_QINIU_BUCKET_PUBLIC=true

# 滑块验证码（对齐 mypage）
CAPTCHA_TTL_SECONDS=120
CAPTCHA_TOKEN_TTL_SECONDS=300
CAPTCHA_TOLERANCE_PX=5
CAPTCHA_MAX_FAILURES=5
CAPTCHA_IMAGE_SOURCE=remote
CAPTCHA_REMOTE_URLS=https://t.alcy.cc/ycy,https://t.alcy.cc/fj
CAPTCHA_BG_WIDTH=320
CAPTCHA_BG_HEIGHT=160
CAPTCHA_PUZZLE_SIZE=60
