# deploy/docker-compose.yml 用：api 容器连宿主机 / 外置 MySQL、Redis
# cp .env.example .env 后按需修改（含七牛密钥）；勿提交 .env

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=infra123!
MYSQL_DATABASE=go_blog
MYSQL_DOCKER=mysql

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=infra123!

TOKEN_TTL_SECONDS=604800
TOKEN_COOKIE_NAME=token
TOKEN_COOKIE_NAME_ADMIN=token_admin
TOKEN_HEADER_NAME=X-Token
# 上线 HTTPS 后改为 true；本地 HTTP 用 auto/false
TOKEN_COOKIE_SECURE=auto

# 正式站 example.com；本机调试可附带 127.0.0.1:8088
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://resume.example.com,http://127.0.0.1:8088,http://localhost:8088
# 容器内建议 /app/data/rsa_private.pem（compose 已挂 volume）
AUTH_RSA_KEY_PATH=/app/data/rsa_private.pem
# sitemap / IndexNow 等对外绝对地址
PUBLIC_SITE_URL=https://example.com
# IndexNow 密钥（须与 blog/public/{key}.txt 文件名与内容一致）；空则不推送
INDEXNOW_KEY=

APP_NAME=go-blog
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

DEFAULT_FILE_ENGINE=QINIU
STORAGE_UPLOAD_MAX_BYTES=10485760
STORAGE_PRESIGN_EXPIRE_SECONDS=3600
STORAGE_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf,.txt,.md,.zip

# MinIO / Silo（暂不用）
# STORAGE_MINIO_ACCESS_KEY=admin
# STORAGE_MINIO_SECRET_KEY=infra123!
# STORAGE_MINIO_ENDPOINT=host.docker.internal:9000
# STORAGE_MINIO_BUCKET=go-blog
# STORAGE_MINIO_REGION=
# STORAGE_MINIO_USE_SSL=false
# STORAGE_MINIO_BASE_URL=http://localhost:8088
# STORAGE_MINIO_BUCKET_PUBLIC=false

STORAGE_QINIU_ACCESS_KEY=
STORAGE_QINIU_SECRET_KEY=
STORAGE_QINIU_ENDPOINT=
STORAGE_QINIU_BUCKET=
STORAGE_QINIU_REGION=z2
# 七牛控制台 HTTPS 保持「关」（不计七牛 HTTPS 用量）
# 对外由 Caddy 为 IMAGE_DOMAIN 签证，BASE_URL 用 https:// 给浏览器
STORAGE_QINIU_USE_SSL=true
STORAGE_QINIU_BASE_URL=https://images.example.com
STORAGE_QINIU_BUCKET_PUBLIC=false

CAPTCHA_TTL_SECONDS=120
CAPTCHA_TOKEN_TTL_SECONDS=300
CAPTCHA_TOLERANCE_PX=5
CAPTCHA_MAX_FAILURES=5
CAPTCHA_IMAGE_SOURCE=remote
CAPTCHA_REMOTE_URLS=https://t.alcy.cc/ycy,https://t.alcy.cc/fj
CAPTCHA_BG_WIDTH=320
CAPTCHA_BG_HEIGHT=160
CAPTCHA_PUZZLE_SIZE=60

# ---- gateway（Caddy，对齐 example.github.io）----
# 本地：不设 SITE_DOMAIN，GATEWAY_HTTP_PORT=8088
# 线上 docker-compose.prod.yml：
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
# 图床：DNS A → 本机；Caddy HTTPS；回源七牛 CDN 的 CNAME 主机（HTTP）
IMAGE_DOMAIN=images.example.com
IMAGE_UPSTREAM=cdn.example.com
# 简历子域名：DNS A/CNAME → 与主站同机（不要指七牛）
RESUME_DOMAIN=resume.example.com
# 线上 compose 固定拉 :latest；版本号仅本机 docker-push 打 tag 用

